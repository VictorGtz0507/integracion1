<%- include('partials/head') %><section class="intro"><p class="kicker">CATÁLOGO CURADO · EDICIÓN 2026</p><h1>Historias que<br><em>dejan huella.</em></h1><p class="lead">Una librería para descubrir obras, autores y las ideas que viven entre sus páginas.</p></section><section class="book-grid"><% books.forEach(book => { %><article class="book-card"><div class="cover"><% if (book.image) { %><img src="/uploads/<%= book.image %>" alt="Portada de <%= book.title %>"><% } else { %><span><%= book.title.slice(0, 1) %></span><% } %></div><div><p class="kicker"><%= book.categories || 'SIN CATEGORÍA' %></p><h2><%= book.title %></h2><p class="muted"><%= book.authors || 'Autor no asignado' %></p><p><%= book.description || 'Una nueva incorporación al catálogo.' %></p><strong><%= (book.price_cents / 100).toFixed(2) %> €</strong></div></article><% }) %><% if (!books.length) { %><p class="empty">El catálogo está listo para recibir su primer libro.</p><% } %></section><%- include('partials/foot') %>
