<%- include('partials/head') %><div class="dash-head"><div><p class="kicker">PANEL DE GESTIÓN</p><h1>Biblioteca<br><em>en orden.</em></h1></div><p class="muted">Sesión: <%= user.name %></p></div><% if (notice) { %><div class="alert"><%= notice %></div><% } %><div class="stats"><div><b><%= books.length %></b><span>Libros</span></div><div><b><%= authors.length %></b><span>Autores</span></div><div><b><%= concepts.length %></b><span>Definiciones</span></div><div><b><%= users.length %></b><span>Usuarios</span></div></div><section class="admin-section"><div class="section-title"><h2>Catálogo</h2><span>CRUD de libros</span></div><form method="post" action="/books" class="form grid-form"><label>Título<input name="title" required></label><label>ISBN<input name="isbn" required></label><label>Precio (€)<input name="price" type="number" min="0" step="0.01" required></label><label>Stock<input name="stock" type="number" min="0" value="0"></label><label>Año<input name="published_year" type="number" min="0"></label><label>Descripción<input name="description"></label><label>Autores<select name="authors" multiple><% authors.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></label><label>Categorías<select name="categories" multiple><% categories.forEach(item => { %><option value="<%= item.id %>"><%= item.name %></option><% }) %></select></label><button class="primary">Añadir libro</button></form><div class="table-wrap"><table><thead><tr><th>Libro</th><th>Autoría</th><th>Precio</th><th>Stock</th><th></th></tr></thead><tbody><% books.forEach(book => { %><tr><td><strong><%= book.title %></strong><small><%= book.isbn %></small></td><td><%= book.authors || '—' %></td><td><%= (book.price_cents / 100).toFixed(2) %> €</td><td><%= book.stock %></td><td><form method="post" action="/books/<%= book.id %>/delete"><button class="danger" title="Eliminar libro">Eliminar</button></form></td></tr><% }) %></tbody></table></div></section><section class="columns"><div class="admin-section"><div class="section-title"><h2>Autores</h2><span><%= authors.length %></span></div><form method="post" action="/authors" class="form"><label>Nombre<input name="name" required></label><label>Biografía<textarea name="biography"></textarea></label><button class="button">Crear autor</button></form><ul class="plain-list"><% authors.forEach(item => { %><li><span><%= item.name %></span><form method="post" action="/authors/<%= item.id %>/delete"><button class="icon-button">×</button></form></li><% }) %></ul></div><div class="admin-section"><div class="section-title"><h2>Categorías</h2><span><%= categories.length %></span></div><form method="post" action="/categories" class="form"><label>Nombre<input name="name" required></label><label>Descripción<input name="description"></label><button class="button">Crear categoría</button></form><ul class="plain-list"><% categories.forEach(item => { %><li><span><%= item.name %></span><form method="post" action="/categories/<%= item.id %>/delete"><button class="icon-button">×</button></form></li><% }) %></ul></div></section><section class="columns"><div class="admin-section"><div class="section-title"><h2>Definiciones</h2><span>Glosario</span></div><form method="post" action="/concepts" class="form"><label>Libro<select name="book_id" required><% books.forEach(item => { %><option value="<%= item.id %>"><%= item.title %></option><% }) %></select></label><label>Término<input name="term" required></label><label>Definición<textarea name="definition" required></textarea></label><button class="button">Guardar término</button></form><ul class="plain-list"><% concepts.forEach(item => { %><li><span><strong><%= item.term %></strong><small><%= item.title %></small></span><form method="post" action="/concepts/<%= item.id %>/delete"><button class="icon-button">×</button></form></li><% }) %></ul></div><div class="admin-section"><div class="section-title"><h2>Imágenes</h2><span>Portadas</span></div><form method="post" action="/images" enctype="multipart/form-data" class="form"><label>Libro<select name="book_id" required><% books.forEach(item => { %><option value="<%= item.id %>"><%= item.title %></option><% }) %></select></label><label>Archivo<input name="image" type="file" accept="image/*" required></label><button class="button">Subir imagen</button></form><ul class="plain-list"><% images.forEach(item => { %><li><span><%= item.original_name %><small><%= item.title %></small></span><form method="post" action="/images/<%= item.id %>/delete"><button class="icon-button">×</button></form></li><% }) %></ul></div></section><section class="admin-section"><div class="section-title"><h2>Usuarios registrados</h2><span>Accesos internos</span></div><form method="post" action="/users" class="form grid-form"><label>Nombre<input name="name" required></label><label>Correo<input name="email" type="email" required></label><label>Contraseña<input name="password" type="password" minlength="8" required></label><label>Rol<select name="role"><option value="staff">Staff</option><option value="admin">Admin</option></select></label><button class="primary">Registrar usuario</button></form><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th></th></tr></thead><tbody><% users.forEach(item => { %><tr><td><%= item.name %></td><td><%= item.email %></td><td><%= item.role %></td><td><% if (item.id !== user.id) { %><form method="post" action="/users/<%= item.id %>/delete"><button class="danger">Eliminar</button></form><% } %></td></tr><% }) %></tbody></table></div></section><%- include('partials/foot') %>
